# Leave empty locally so CRA proxy (package.json) is used — required for refresh cookie on F5.
# For deployed builds set the real API origin, e.g. https://mat-api.example.com
REACT_APP_API_URL=

REACT_APP_USE_MOCK_LOGIN=false
REACT_APP_AES_PASSPHRASE=change-me
REACT_APP_PAYLOAD_SECRET=change-me
REACT_APP_PAYLOAD_SALT=change-me
REACT_APP_PAYLOAD_ENCRYPTION=true
REACT_APP_PAYLOAD_HMAC=true
