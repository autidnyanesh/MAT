.bank-login-container {
  height: 100vh;
  width: 100%;
  background: url("../images/idbiWall.png") no-repeat center center/cover;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* Dark banking overlay */
.overlay {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(0, 70, 60, 0.75);
  backdrop-filter: blur(4px);
}

/* Login Card */
.login-card {
  position: relative;
  z-index: 2;
  width: 370px;
  padding: 35px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(15px);
  box-shadow: 0 0 25px rgba(0, 0, 0, 0.5);
  text-align: center;
  color: white;
}

/* Titles */
.bank-title {
  font-size: 22px;
  font-weight: bold;
  margin-bottom: 5px;
}

.bank-subtitle {
  font-size: 13px;
  margin-bottom: 20px;
  opacity: 0.8;
}

/* Inputs */
.login-card input {
  width: 100%;
  padding: 11px 0px 11px 10px;
  margin-bottom: 15px;
  border: none;
  border-radius: 6px;
  outline: none;
  font-size: 16px;
}

/* Button */
.login-card button {
  width: 40%;
  padding: 12px;
  background: #f58220; /* IDBI orange */
  color: white;
  border: none;
  border-radius: 6px;
  font-weight: bold;
  cursor: pointer;
  transition: 0.3s;
  
}

.login-card button:hover {
  background: #d96b10;
}

/* Error */
.error {
  color: #ffb3b3;
  font-size: 13px;
  margin-bottom: 10px;
}

/* Footer */
.footer-text {
  margin-top: 10px;
  font-size: 11px;
  opacity: 0.7;
}

.captcha-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 15px;
}

/* Captcha text */
.captcha-text {
  flex: 1;
  text-align: center;
  font-weight: bold;
  letter-spacing: 3px;
  font-size: 16px;
  background: #fff;
  padding: 10px;
  border-radius: 6px;
  color: #333;
  user-select: none;
}

/* Refresh button */
.refresh-btn {
  width: 50px;
  height: 40px;
  background: #f58220;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  color: white;
  font-size: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.refresh-btn:hover {
  background: #d96b10;
}

/* SIGNUP TEXT */
.signup-text {
  font-size: 13px;
  margin-top: 10px;
  color: #ddd;
}

.signup-text span {
  color: #f58220;
  cursor: pointer;
  font-weight: bold;
}

.signup-text span:hover {
  text-decoration: underline;
}
.role-select-label{
    margin-bottom: 10px;
    font-size: 16px;
    display: flex;
    color: #ddd;
}