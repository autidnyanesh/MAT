import React, { useState } from "react";
import { BrowserRouter, Routes, Route } from "react-router-dom";
import Navbar from "./components/Navbar";
import Login from "./pages/Login";
import Dashboard from "./pages/Dashboard";
import RequestHandling from "./pages/RequestHandling";
import Report from "./pages/Report";
import AddUser from "./pages/AddUser";
import DeleteUser from "./pages/DeleteUser";
import ActivateUser from "./pages/ActivateUser";
import Register from "./pages/Register";
import "./styles/main.css";

function App() {
  const [user, setUser] = useState(null);
  const [theme, setTheme] = useState("light");
  const [page, setPage] = useState("login");

  if (!user) {
    return page === "login" ? (
      <Login onLogin={setUser} goToRegister={() => setPage("register")} />
    ) : (
      <Register goToLogin={() => setPage("login")} />
    );
  }

  return (
    <BrowserRouter>
      <div className={`app ${theme}`}>
        <Navbar user={user} onLogout={() => setUser(null)} theme={theme} setTheme={setTheme} />
        <div className="content">
          <Routes>
            <Route path="/" element={<Dashboard />} />
            <Route path="/request-handle" element={<RequestHandling />} />
            <Route path="/report" element={<Report />} />
            {/* <Route path="/approval" element={<ApprovalQueue />} /> */}
            <Route path="/add-user" element={<AddUser />} />
            <Route path="/delete-user" element={<DeleteUser />} />
            <Route path="/activate-user" element={<ActivateUser />} />
          </Routes>
        </div>
      </div>
    </BrowserRouter>
  );
}

export default App;
