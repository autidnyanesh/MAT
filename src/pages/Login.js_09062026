import React, { useState, useEffect } from "react";
import CryptoJS from "crypto-js";
import "../styles/login.css";
import axios from "axios";

const AES_SECRET = "MAT_LOGIN_SECRET_KEY_2026";
const DEMO_SALT = CryptoJS.enc.Hex.parse("00112233445566778899aabbccddeeff");
const DEMO_IV = CryptoJS.enc.Hex.parse("0102030405060708090a0b0c0d0e0f10");

const deriveAesKey = (salt) => CryptoJS.SHA256(
  CryptoJS.enc.Utf8.parse(`${AES_SECRET}:${salt.toString()}`)
);

const encryptPassword = (plainText, salt, iv) => {
  const key = deriveAesKey(salt);
  return CryptoJS.AES.encrypt(plainText, key, {
    iv,
    mode: CryptoJS.mode.CBC,
    padding: CryptoJS.pad.Pkcs7,
  }).toString();
};

const createEncryptedPayload = (plainText) => {
  const salt = CryptoJS.lib.WordArray.random(16);
  const iv = CryptoJS.lib.WordArray.random(16);

  return {
    encryptedPassword: encryptPassword(plainText, salt, iv),
    salt: salt.toString(),
    iv: iv.toString(),
  };
};

const TEMP_ENCRYPTED_PASSWORD = encryptPassword("temp1234", DEMO_SALT, DEMO_IV);

function Login({ onLogin, goToRegister }) {
  const [username, setUsername] = useState("");
  const [password, setPassword] = useState("");
  const [captcha, setCaptcha] = useState("");
  const [userCaptcha, setUserCaptcha] = useState("");
  const [error, setError] = useState("");
  const [pError, setPError] = useState("");
  const [uError, setUError] = useState("");
  const [role] = useState("BU");
  const TEMP_USER = { username: "tempuser", password: "temp1234" };

  const generateCaptcha = () => {
    const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789abcdefghijklmnopqrstuvwxyz";
    let cap = "";
    for (let i = 0; i < 6; i++) cap += chars.charAt(Math.floor(Math.random() * chars.length));
    setCaptcha(cap);
  };

  useEffect(() => { generateCaptcha(); }, []);

  const handleLogin = async () => {
    if (username === "") {
      setUError("Please Enter User ID");
      return;
    }
    else if (password === "") {
      setUError("");
      setPError("Please Enter Password");
      return;
    }
    else if (userCaptcha !== captcha) {
      setPError("");
      setError("Invalid Captcha. Please try again.");
      generateCaptcha();
      setUserCaptcha("");
      return;
    }

    const demoPasswordMatches = encryptPassword(password, DEMO_SALT, DEMO_IV) === TEMP_ENCRYPTED_PASSWORD;

    if (username === TEMP_USER.username && demoPasswordMatches) {
      setError("");
      onLogin({
        username: TEMP_USER.username,
        displayName: "Temporary User",
        role,
      });
      return;
    }

    const encryptedPayload = createEncryptedPayload(password);

    try {
      const response = await axios.post("http://localhost:8080/api/login", {
        username,
        password: encryptedPayload.encryptedPassword,
        legacyPassword: password,
        passwordSalt: encryptedPayload.salt,
        passwordIv: encryptedPayload.iv,
        passwordAlgorithm: "AES-CBC-SHA256",
      });

      if (response.status === 200) {
        // if (!response.data.username) {
        //   setError(data.message || "Login failed.");
        //   generateCaptcha();
        //   setUserCaptcha("");
        //   return;
        // }

        setError("");
        // 👇 Pass role along with user info
        onLogin({
          //username: data.username,
          //displayName: data.displayName,
          role: role   // 👈 role comes from dropdown
        });
      } else {
        setError("Login failed. Please try again.");
        generateCaptcha();
        setUserCaptcha("");
      }
    } catch (err) {
      if (err.response) {
        setError(err.response.data.message || "Login failed");
      } else {
        setError("Network error");
      }
      generateCaptcha();
      setUserCaptcha("");
    }
  };

  const handleKey = (e) => { if (e.key === "Enter") handleLogin(); };

  return (
    <div className="auth-page">
      <div className="auth-card">

        {/* RIGHT — Image panel */}
        <div className="auth-image-side">
          <div className="auth-image-overlay">
            <h3>Merchant Tool</h3>
          </div>
        </div>

        {/* LEFT — Form */}
        <div className="auth-form-side">
          <h3 className="auth-heading">Welcome back</h3>
          <p className="auth-sub">Sign in to your account to continue</p>

          <div className="auth-field">
            <label>User Name</label>
            <input
              type="text"
              placeholder="Enter your User ID"
              value={username}
              onChange={e => setUsername(e.target.value)}
              onKeyDown={handleKey}
            />
          </div>
          {uError && <p className="auth-error">{uError}</p>}

          <div className="auth-field">
            <label>Password</label>
            <input
              type="password"
              placeholder="Enter your password"
              value={password}
              onChange={e => setPassword(e.target.value)}
              onKeyDown={handleKey}
            />
          </div>
          {pError && <p className="auth-error">{pError}</p>}

          {/* Role selector for testing */}
          {/* <div className="auth-field">
            <label>Role</label>
            <select value={role} onChange={(e) => setRole(e.target.value)}>
              <option value="BU">Branch User</option>
              <option value="SOM">SOM</option>
              <option value="BH">Branch Head</option>
              <option value="RH">Regional Head</option>
              <option value="DCO">DCO</option>
              <option value="AGM">AGM</option>3
              <option value="DGM">DGM</option>
            </select>
          </div> */}

          <div className="auth-field">
            <label>Captcha</label>
            <div className="captcha-row">
              <div className="captcha-display">{captcha}</div>
              <button className="captcha-refresh" onClick={generateCaptcha} title="Refresh">↻</button>
            </div>
            <input
              type="text"
              placeholder="Enter captcha above"
              value={userCaptcha}
              onChange={e => setUserCaptcha(e.target.value)}
              onKeyDown={handleKey}
            />
          </div>

          {error && <p className="auth-error">{error}</p>}

          <button className="auth-btn" onClick={handleLogin}>SIGN IN</button>

          {/* <p className="auth-switch">
            Don't have an account?{" "}
            <span onClick={goToRegister}>Register here</span>
          </p> */}

          <p className="auth-footer">Temporary demo: use tempuser / temp1234</p>
        </div>
      </div>
    </div>
  );
}

export default Login;
